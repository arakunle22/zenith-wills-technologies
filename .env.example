# Google Analytics 4 — measurement ID (public value).
# Copy this file to `.env.local` (or set the variable in your hosting dashboard
# for production), then replace the placeholder with the real ID.
#
# The ID must be installed as a GA tag/script (loaded by the <GoogleAnalytics />
# component in src/app/layout.tsx). Do NOT place it in robots.txt, sitemap,
# Search Console, or the site's meta tags.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

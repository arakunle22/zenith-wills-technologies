# ── Google Analytics ────────────────────────────────────────────────
# GA4 measurement ID (public value). Must be installed as a GA tag/script
# (loaded by <GoogleAnalytics /> in src/app/layout.tsx) — never in robots.txt,
# sitemap, Search Console, or meta tags.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ── Quick-update site data ──────────────────────────────────────────
# Read by src/config/site.ts at build time (values below are the code defaults)
# and baked into the HTML, structured data, sitemap and robots.txt. Moving these
# to env does NOT affect SEO — they are public data rendered into the page.
#
# Canonical domain: drives canonicals, sitemap, robots and JSON-LD schema.
NEXT_PUBLIC_SITE_URL=https://zenithwillstechnologies.com
NEXT_PUBLIC_SITE_DESCRIPTION=Professional installation of solar power inverters, CCTV cameras, car trackers, intercoms and system networking across Lagos, Nigeria.

# Contact
NEXT_PUBLIC_PHONE_DISPLAY=081-2829-3556
NEXT_PUBLIC_PHONE_TEL=+2348128293556
NEXT_PUBLIC_WHATSAPP_NUMBER=2348128293556

# Location
NEXT_PUBLIC_ADDRESS_STREET=Victoria Island
NEXT_PUBLIC_ADDRESS_LOCALITY=Victoria Island
NEXT_PUBLIC_ADDRESS_REGION=Lagos State
NEXT_PUBLIC_ADDRESS_POSTAL_CODE=101241
NEXT_PUBLIC_ADDRESS_COUNTRY=NG

# Service areas (comma-separated; site.ts splits + trims)
NEXT_PUBLIC_AREAS_SERVED=Victoria Island,Lekki,Ikoyi,Badagry,Egan,Ikotun,Alimosho,LASU,Mile 2,Lagos

# Social media — one handle used across all platforms (site.ts builds the URLs)
NEXT_PUBLIC_SOCIAL_HANDLE=zenithwillstechnologies
